
# ── Instagram / Meta (DM webhook) ────────────────────────────
# 1. Create a Meta App at https://developers.facebook.com
#    Products → Messenger → Instagram → Add callback URL:
#      https://<project>.supabase.co/functions/v1/import-instagram
#    Subscribe to: messages
#
# 2. Set these secrets:
#    supabase secrets set INSTAGRAM_APP_SECRET=...
#    supabase secrets set INSTAGRAM_VERIFY_TOKEN=any_random_string_you_choose
#    supabase secrets set INSTAGRAM_PAGE_ACCESS_TOKEN=...  (optional: resolves @handles from IGSIDs)

INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_VERIFY_TOKEN=any_random_string_you_pick
INSTAGRAM_PAGE_ACCESS_TOKEN=your_page_access_token  # optional
